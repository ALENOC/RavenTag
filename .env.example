# RavenTag deployment environment template — no secret values are stored here.
NODE_ENV=production
ALLOWED_ORIGINS=https://raventag.com

# Ravencoin RPC
RVN_RPC_HOST=localhost
RVN_RPC_PORT=8766
RVN_PUBLIC_RPC_URL=https://rvn-rpc.publicnode.com

# Docker backup sidecar: point to a local file containing a strong random secret.
# Generate the file yourself, e.g. with: openssl rand -hex 32 > secrets/backup_encryption_key.txt
BACKUP_ENCRYPTION_KEY_FILE=./secrets/backup_encryption_key.txt

# The normal Docker deployment already has a backup sidecar. Leave the optional
# in-process scheduler disabled unless you deliberately deploy without that sidecar.
ENABLE_INTERNAL_BACKUP=false
# When ENABLE_INTERNAL_BACKUP=true, this path must exist inside the backend container/process.
# INTERNAL_BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
